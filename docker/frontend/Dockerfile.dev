# =============================================================================
# chroniq.cc Frontend — Development Dockerfile (Vite HMR)
# =============================================================================
FROM node:22-alpine

LABEL description="chroniq.cc frontend (development)"

WORKDIR /app

COPY frontend/package.json frontend/yarn.lock* ./
RUN yarn install

EXPOSE 5173

CMD ["yarn", "dev", "--host", "0.0.0.0"]
