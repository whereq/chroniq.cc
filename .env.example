# chroniq.cc — environment template. Copy to .env and fill in.
# Consumed by docker/docker-compose*.yml (and locally by backend/.env).

# ---- Shared PostgreSQL (whereq-db) ----
POSTGRES_USER=flowdesk
POSTGRES_PASSWORD=flowdesk
CHRONIQ_DB=chroniq

# ---- URLs ----
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- Keycloak (realm hosted at keytomarvel.com) ----
KEYCLOAK_URL=https://keytomarvel.com
KEYCLOAK_REALM=chroniq.cc
KEYCLOAK_CLIENT_ID=chroniq-spa
KEYCLOAK_ADMIN_CLIENT_ID=chroniq-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ---- Email (transactional) — leave blank for log-only mode ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=chroniq.cc <no-reply@chroniq.cc>

# ---- Google Calendar OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft Graph OAuth ----
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TIER_1=
STRIPE_PRICE_TIER_2=

# ---- Token encryption (Fernet key, base64 32 bytes) ----
TOKEN_ENCRYPTION_KEY=
